{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "startUrl": {
      "type": "string",
      "pattern": "^https:\\/\\/\\S+$"
    },
    "packageName": {
      "type": "string",
      "pattern": "^[a-zA-Z]\\w*(\\.[a-zA-Z]\\w*)+$"
    },
    "appName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^[^\\p{Cc}\\p{Cs}]*$"
    },
    "internalHosts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "statusBarColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "push": {
          "type": "boolean"
        },
        "splashColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "orientation": {
          "type": "string",
          "enum": [
            "unspecified",
            "portrait",
            "landscape"
          ]
        },
        "zoom": {
          "type": "boolean"
        },
        "progressBar": {
          "type": "boolean"
        },
        "pullToRefresh": {
          "type": "boolean"
        },
        "exitDialog": {
          "type": "boolean"
        }
      },
      "required": [
        "statusBarColor",
        "orientation",
        "zoom",
        "progressBar",
        "pullToRefresh",
        "exitDialog"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "startUrl",
    "packageName",
    "appName",
    "internalHosts",
    "ui"
  ],
  "additionalProperties": false
}
