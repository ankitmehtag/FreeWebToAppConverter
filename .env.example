# Port the API listens on, published on 127.0.0.1
PORT=3000

# Local Compose services. Replace these outside local development.
MONGO_URL=mongodb://mongo:27017/sitetoapk
REDIS_URL=redis://redis:6379

# Worker, run on the host with `npm start -w worker`. Local values reach Compose on 127.0.0.1.
BUILDER_IMAGE=sitetoapk-builder:dev
WORK_ROOT=
KEYSTORE_PATH=
KEYSTORE_PASSWORD=
KEY_PASSWORD=
KEY_ALIAS=
SIGNER_SHA256=
BUILD_CONCURRENCY=1
BUILD_TIMEOUT_MS=900000

# Cloudflare R2 for artifacts and app icons. The token must be limited to this bucket.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Accounts. Generate JWT_SECRET with `openssl rand -hex 32`.
# In production APP_URL is https://freewebsitetoappconverter.com, and MAIL_FROM uses that domain once Resend has verified it.
JWT_SECRET=local-development-only-secret-replace-me
APP_URL=http://localhost:5173
# Optional. The proxy allowed to name the visitor's IP, as Express's `trust proxy` value: an IP, a subnet,
# `loopback`, or a hop count. Leave empty when nothing sits in front of the API.
TRUST_PROXY=
# Where reports from install pages are emailed. Empty stores them without an email.
REPORTS_EMAIL=
# Optional. Google Web Risk API key for the unsafe-site check. Empty leaves that check off.
WEB_RISK_API_KEY=
# Optional. Where install links (QR codes) point. A phone can't open localhost, so local tests use the Mac's LAN address.
INSTALL_URL=
API_URL=http://localhost:3000
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=Free Website to App Converter <noreply@localhost>
# Set to send through Resend instead of SMTP.
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Premium signing keys are sealed with this. id:base64 of 32 random bytes (openssl rand -base64 32), comma separated; the first seals, all open. Keep a copy off the server.
KEYSTORE_MASTER_KEY=
# Razorpay keys. Leave empty and nothing is for sale. Use test keys outside production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# The owner's email(s), comma separated. Only they can open /admin, and only after a code from an authenticator app (npm run admin-2fa -w server -- <email>). Empty turns the panel off.
ADMIN_EMAILS=
